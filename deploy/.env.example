# Copy to .env (never commit .env!) and populate secret files under ./secrets/

# Pin a specific release tag (e.g. :1.0.0) in production, or keep :latest
DEEPSKY_SERVER_IMAGE=ghcr.io/manuel-materazzo/deep-sky-server:latest
DEEPSKY_DOMAIN=deepsky.vectevo.com
SPRING_PROFILES_ACTIVE=prod

POSTGRES_DB=deepsky
POSTGRES_USER=deepsky

DEEPSKY_MIN_CLIENT_VERSION_CODE=1
DEEPSKY_MIN_PROTOCOL_VERSION=1
DEEPSKY_MAX_BLOB_BYTES=10485760
DEEPSKY_MAX_COUPLE_STORAGE_BYTES=1073741824

DEEPSKY_FIREBASE_ENABLED=false
DEEPSKY_FIREBASE_PROJECT_ID=
DEEPSKY_FIREBASE_API_KEY=
DEEPSKY_FIREBASE_APP_ID=
DEEPSKY_FIREBASE_SENDER_ID=
# When DEEPSKY_FIREBASE_ENABLED=true with deploy/docker-compose.firebase.yml:
# DEEPSKY_FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase_service_account.json

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError
API_MEM_LIMIT=512M
DB_MEM_LIMIT=256M
