{
	auto_https disable_redirects
}

{$DEEPSKY_DOMAIN:localhost} {
	encode zstd gzip

	# Minimal access logs without query strings or user-identifying headers (INF-06, S-07)
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
	}

	handle /actuator/health* {
		reverse_proxy api:8080
	}

	# Block external access to all other actuator endpoints (INF-02)
	handle /actuator* {
		respond 404
	}

	handle {
		reverse_proxy api:8080
	}
}
