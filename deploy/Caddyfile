{
	auto_https disable_redirects
}

{$DEEPSKY_DOMAIN:localhost} {
	encode zstd gzip

	# Cap request bodies before proxying to the 256 MB JVM API container (AU-14)
	request_body {
		max_size 2MB
	}

	# Transport and framing hardening (AU-26)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	# Minimal access logs without request URIs, query strings, or user-identifying headers (INF-06, S-07, CA-05)
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
	}

	handle /actuator/health* {
		reverse_proxy api:8080
	}

	# Android App Links verification without touching the Spring Boot API (`S1-INF-01`).
	handle /.well-known/assetlinks.json {
		root * /srv/web
		header Content-Type application/json
		header Cache-Control "public, max-age=3600"
		file_server
	}

	# Static bilingual invite/install landing page (`S1-INF-01`, `S1-DES-03`, `AU-26`).
	# Invite secrets reside solely in the browser `#fragment` and never reach Caddy logs.
	handle /join* {
		root * /srv/web
		try_files {path} /join/index.html
		header Cache-Control "no-store"
		header X-Content-Type-Options "nosniff"
		header X-Frame-Options "DENY"
		header Referrer-Policy "no-referrer"
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		file_server
	}

	# Block external access to all other actuator endpoints (INF-02)
	handle /actuator* {
		respond 404
	}

	handle {
		reverse_proxy api:8080
	}
}
